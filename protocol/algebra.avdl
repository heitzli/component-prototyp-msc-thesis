@namespace("algebra")
protocol AlgebraPlan {

    record ResolvedColumn {
        string relation_id;
        string name;
        string type;
    }

    record AlgebraNode {
        union { TableScan, Projection, Product } node;
    }

    record TableScan {
        string relation_id;
        string table;
        string? alias = null;
    }

    record Projection {
        array<ResolvedColumn> columns;
        AlgebraNode child;
    }

    record Product {
        AlgebraNode left;
        AlgebraNode right;
    }

    record OptimizeRequest {
        int protocol_version;
        AlgebraNode root;
    }

    record OptimizeResponse {
        int protocol_version;
        AlgebraNode root;
    }

    OptimizeResponse optimize(OptimizeRequest request);
}
